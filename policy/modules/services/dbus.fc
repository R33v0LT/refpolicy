# Конфигурационные файлы
/etc/dbus-1(/.*)?				gen_context(system_u:object_r:dbus_etc_t,s0)
/etc/dbus-1/system\.conf			--	gen_context(system_u:object_r:dbus_etc_t,s0)
/etc/dbus-1/session\.conf			--	gen_context(system_u:object_r:dbus_etc_t,s0)

# Исполняемые файлы
/usr/bin/dbus-daemon				--	gen_context(system_u:object_r:dbus_exec_t,s0)
/usr/bin/dbus-launch				--	gen_context(system_u:object_r:dbus_exec_t,s0)
/usr/bin/dbus-monitor				--	gen_context(system_u:object_r:dbus_exec_t,s0)
/usr/bin/dbus-send				--	gen_context(system_u:object_r:dbus_exec_t,s0)
/usr/bin/dbus-uuidgen				--	gen_context(system_u:object_r:dbus_exec_t,s0)
/usr/bin/dbus-update-activation-environment	--	gen_context(system_u:object_r:dbus_exec_t,s0)
/usr/bin/gdbus				--	gen_context(system_u:object_r:dbus_exec_t,s0)
/usr/bin/dbus-test-tool			--	gen_context(system_u:object_r:dbus_exec_t,s0)

# Библиотеки
/usr/lib/libdbus-1\.so.*			--	gen_context(system_u:object_r:dbus_lib_t,s0)
/usr/lib/libdbus-glib-1\.so.*		--	gen_context(system_u:object_r:dbus_lib_t,s0)

# Демоны
/usr/libexec/dbus-daemon-launch-helper	--	gen_context(system_u:object_r:dbus_exec_t,s0)

# Runtime файлы
/run/dbus(/.*)?					gen_context(system_u:object_r:dbus_runtime_t,s0)
/run/dbus/system_bus_socket		-s	gen_context(system_u:object_r:dbus_runtime_t,s0)
/run/dbus/session_bus_socket		-s	gen_context(system_u:object_r:dbus_runtime_t,s0)

# Данные
/var/lib/dbus(/.*)?				gen_context(system_u:object_r:dbus_var_lib_t,s0)
